# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key from: https://supabase.com/dashboard/project/<ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
# Worker URL and upload secret from your Cloudflare Workers dashboard
VITE_R2_WORKER_URL=https://<worker-name>.<account>.workers.dev
VITE_R2_UPLOAD_SECRET=<your-upload-secret>

# ── OpenAI (caption generation) ───────────────────────────────────────────────
VITE_OPENAI_API_KEY=sk-...

# ── Google Drive (OAuth — asset import) ───────────────────────────────────────
# Client ID from Google Cloud Console (OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
