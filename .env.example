# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and anon key from: https://supabase.com/dashboard/project/<ref>/settings/api
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Cloudflare R2 (media storage) ─────────────────────────────────────────────
# The bucket is PRIVATE. The Worker authenticates the caller's Supabase session
# and mints short-lived signed URLs, so there is no shared secret to put here.
# Anything in a VITE_ var ships in the public JS bundle — that is exactly how
# the old VITE_R2_UPLOAD_SECRET leaked, and it has been retired. Do not add it
# back. Server-side callers use R2_SERVICE_SECRET, which never reaches the app.
VITE_R2_WORKER_URL=https://<worker-name>.<account>.workers.dev
# Canonical media URL prefix — an identifier, not a fetchable address.
VITE_R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── OpenAI (caption generation) ───────────────────────────────────────────────
VITE_OPENAI_API_KEY=sk-...

# ── Google Drive (OAuth — asset import) ───────────────────────────────────────
# Client ID from Google Cloud Console (OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com
